# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit real values.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# mysql2 connection string used by packages/db
DATABASE_URL="mysql://user:password@host:3306/dropx?ssl-mode=REQUIRED"

# --- API ------------------------------------------------------------------
API_PORT=8000
API_BASE_URL="http://localhost:8000"
# Comma-separated list of allowed CORS origins: web 3000, admin 5173, riders 5174
API_CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:5174"
API_LOG_LEVEL=info
# Comma-separated list of allowed public tracking rate limit
API_TRACKING_RATE_LIMIT=30

# --- Sessions / auth ------------------------------------------------------
# 32+ byte secret used to sign session tokens
APP_SECRET="change-me-to-a-long-random-string"
# Token lifetimes (seconds)
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=1209600
# Comma-separated list of allowed token audiences, one per app
TOKEN_AUDIENCES="admin,riders,web"

# --- Cache / Redis --------------------------------------------------------
# OTP codes + rate limits live in Redis, never in MySQL
REDIS_URL="redis://localhost:6379"

# --- Frontends ------------------------------------------------------------
# Frontend URLs live in each app's own `.env` (auto-loaded by Vite/Next from
# the app directory); see apps/web/.env.example, apps/admin/.env.example and
# apps/riders/.env.example for the templates.

# --- Ops ------------------------------------------------------------------
# First administrator. Nothing else can create a `users` row, so this is
# the only way in on a fresh database; later staff are added in the admin.
# One-shot: an email that already exists is left untouched.
BOOTSTRAP_ADMIN_EMAIL="you@company.com"
BOOTSTRAP_ADMIN_PASSWORD="change-me-to-a-long-random-string"
BOOTSTRAP_ADMIN_NAME="Administrator"

# --- Email / SMTP ---------------------------------------------------------
# Sender address shown in the From header
MAIL_FROM="no-reply@dropx.local"
# SMTP server — leave MAIL_HOST unset to silently drop mail (dev/test)
MAIL_HOST="smtp.example.com"
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER="user@example.com"
MAIL_PASSWORD="change-me-to-a-long-random-string"
# Public HTTPS URL for the approved email signature SVG. Gmail blocks data URIs.
MAIL_BRAND_ASSET_URL="https://your-public-domain.example/brand/dropx-email-signature-light.svg"
