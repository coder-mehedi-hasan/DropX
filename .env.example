# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit real values.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# mysql2 connection string used by packages/db
DATABASE_URL="mysql://user:password@host:3306/dropx?ssl-mode=REQUIRED"

# --- API ------------------------------------------------------------------
API_PORT=4000
API_BASE_URL="http://localhost:4000"
# Comma-separated list of allowed CORS origins
API_CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:3000"
API_LOG_LEVEL=info
# Comma-separated list of allowed public tracking rate limit
API_TRACKING_RATE_LIMIT=30

# --- Sessions / auth ------------------------------------------------------
# 32+ byte secret used to sign session tokens
APP_SECRET="change-me-to-a-long-random-string"
# Token lifetimes (seconds)
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=1209600
# Comma-separated list of allowed token audiences, one per app
TOKEN_AUDIENCES="console,riders,web"

# --- Cache / Redis --------------------------------------------------------
# OTP codes + rate limits live in Redis, never in MySQL
REDIS_URL="redis://localhost:6379"

# --- Frontends ------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:4000"
VITE_API_URL="http://localhost:4000"

# --- Ops ------------------------------------------------------------------
# Optional: email/sms provider credentials for notifications
MAIL_FROM="no-reply@dropx.local"
