{
  "name": "@dropx/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Database-agnostic access layer for DropX. Ports + entities live here; drivers live in ./adapters.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./port": "./src/port/index.ts",
    "./entities": "./src/entities/index.ts",
    "./adapters/mysql2": "./src/adapters/mysql2/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf node_modules .turbo dist",
    "migrate": "bun --env-file=../../.env run ./scripts/migrate.ts",
    "reset": "bun --env-file=../../.env run ./scripts/migrate.ts -- --reset"
  },
  "dependencies": {
    "mysql2": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  }
}
