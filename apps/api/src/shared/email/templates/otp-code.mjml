<mjml>
  <mj-head>
    <mj-title>DropX — Your verification code</mj-title>
    <mj-attributes>
      <mj-all font-family="Inter, Helvetica, Arial, sans-serif" />
      <mj-section background-color="#FFFFFF" padding="0" />
      <mj-column background-color="#FFFFFF" />
    </mj-attributes>
    <mj-style>
      .pre {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      }
    </mj-style>
  </mj-head>
  <mj-body>
    <mj-section padding="24px 16px" background-color="#FFFFFF">
      <mj-column>
        <mj-image
          src="{{brandSignatureCid}}"
          alt="DropX Smart Logistics"
          width="220px"
          padding="0"
          align="left"
        />
      </mj-column>
    </mj-section>

    <mj-section padding="40px 16px" background-color="#FFFFFF">
      <mj-column>
        <mj-text
          font-size="28px"
          font-weight="700"
          color="#0D0F12"
          letter-spacing="-0.02em"
          padding-bottom="8px"
        >
          Verify your account
        </mj-text>
        <mj-text font-size="16px" color="#475467" padding-bottom="28px">
          Use the code below to complete your sign-in. It expires in 5 minutes.
        </mj-text>

        <mj-text
          font-size="36px"
          font-weight="700"
          color="#FF5500"
          class="pre"
          padding-bottom="28px"
          align="center"
        >
          {{ code }}
        </mj-text>

        <mj-text font-size="14px" color="#475467" padding-bottom="8px">
          If you did not request this code, you can ignore this email.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="20px 16px" background-color="#F7F8FA">
      <mj-column>
        <mj-text font-size="12px" color="#A1A1AA" align="center">
          &copy; DropX. All rights reserved.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
