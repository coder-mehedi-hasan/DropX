# Backend API configuration.
#
# The API reads this file automatically — Bun loads `.env` from the app directory,
# so no script passes `--env-file`. Override locally in `.env.local`.
#
# Every key below is optional except DATABASE_URL; the value shown is the default
# the code already applies, so an entry only needs to exist when you want to
# change it.

# --- Database (required) --------------------------------------------------
# The only database the API reaches. Also fixes how DATETIME columns are read:
# the pool pins mysql2 to UTC, so timestamps do not shift with the host's zone.
DATABASE_URL="mysql://user:password@host:3306/dropx"

# --- Server ---------------------------------------------------------------
API_PORT=8000
API_BASE_URL="http://localhost:8000"
API_CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:5174"
API_LOG_LEVEL="info"
# Set when running behind a reverse proxy that sets X-Forwarded-For.
API_TRUST_PROXY=false

# --- Auth -----------------------------------------------------------------
# Must be at least 32 characters, and must NOT start with "dev-only" in
# production — the boot check refuses that.
APP_SECRET="dev-only-insecure-secret-change-me-now-please"
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=1209600
# One audience per app, so an admin token cannot call rider endpoints.
TOKEN_AUDIENCES="admin,riders,web"

# --- First-run bootstrap --------------------------------------------------
# Nothing else writes a `users` row, so this is the only way in on a fresh
# database. It is an API, not a script:
#
#   POST /api/v1/admin/bootstrap   { token, name, email, password }
#
# Easiest from /docs. Two locks: the body's `token` must equal this value, and the
# route refuses once any account holds the ADMIN role — so it is permanently
# closed after first use. Unset means every call is refused, so a deploy that
# forgot this is closed rather than open. At least 16 characters.
#
# Later staff are added from the admin app, not from here.
# BOOTSTRAP_TOKEN="at-least-16-chars-keep-it-secret"

# --- Redis ----------------------------------------------------------------
# OTP codes for the customer portal. Required in production.
REDIS_URL="redis://localhost:6379"

# --- Email / SMTP ---------------------------------------------------------
# MAIL_HOST unset means mail is silently dropped (dev/test).
MAIL_FROM="no-reply@dropx.local"
# MAIL_HOST="smtp.example.com"
# MAIL_PORT=587
MAIL_SECURE=false
# MAIL_USER="apikey"
# MAIL_PASSWORD="secret"
# Required in production: a public HTTPS URL to the brand logo.
# MAIL_BRAND_ASSET_URL="https://example.com/brand/logo.png"

# --- Object storage (S3-compatible; optional) ------------------------------
# Uploads (avatars, delivery proofs) are stored in any S3-compatible bucket and
# served back as its public URL — the API never proxies file bytes.
#
# The defaults match a stock local MinIO, so this "just works" against:
#   docker run -p 9000:9000 -e MINIO_ROOT_USER=minioadmin \
#     -e MINIO_ROOT_PASSWORD=minioadmin minio/minio server /data
# Point S3_ENDPOINT at any S3 API (AWS, Cloudflare R2, …) to change providers.
#
# S3_ENDPOINT="http://localhost:9000"
# S3_REGION="us-east-1"
# S3_BUCKET="dropx-assets"
# S3_ACCESS_KEY_ID="minioadmin"
# S3_SECRET_ACCESS_KEY="minioadmin"
# Path-style is what local MinIO and R2 use; AWS virtual-host style does not.
# S3_FORCE_PATH_STYLE=true
# Overrides the public URL base, otherwise derived as {endpoint}/{bucket}.
# S3_PUBLIC_URL="http://localhost:9000/dropx-assets"