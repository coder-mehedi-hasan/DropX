{
  "name": "@dropx/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "DropX backend API \u2014 Hono, modular by domain feature.",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir dist",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf node_modules .turbo dist",
    "seed": "bun run ./scripts/seed.ts",
    "seed:locations": "bun run ./scripts/seed-locations.ts",
    "seed:locations:check": "bun run ./scripts/seed-locations.ts --check",
    "seed:demo": "bun run ./scripts/seed-demo.ts",
    "check:read-paths": "API_LOG_LEVEL=silent bun run ./scripts/check-read-paths.ts",
    "migrate": "bun run src/db/migrate.ts",
    "seed:pricing": "bun run ./scripts/seed-pricing.ts"
  },
  "dependencies": {
    "@dropx/types": "workspace:*",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-validator": "^0.9.1",
    "@types/nodemailer": "^8.0.2",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.11",
    "hono": "^4.13.9",
    "ioredis": "^6.0.0",
    "mjml": "^5.4.1",
    "mysql2": "^3.24.5",
    "nodemailer": "^10.0.12",
    "redis": "^6.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  }
}
