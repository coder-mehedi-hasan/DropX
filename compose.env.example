# Copy this file to .env before running Docker Compose.
API_HOST_PORT=8005
MYSQL_DATABASE=dropx
MYSQL_USER=dropx
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-password
# Reuses Redis published on port 6379 by the existing host container.
# Add :password@ after redis:// when that Redis instance requires authentication.
REDIS_URL=redis://host.docker.internal:6379
