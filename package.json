{
  "name": "dropx",
  "version": "0.0.0",
  "devDependencies": {
    "mprocs": "^0.9.6",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "packageManager": "bun@1.3.13",
  "private": true,
  "scripts": {
    "dev": "mprocs",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:admin": "bun run --cwd apps/admin dev",
    "dev:rider": "bun run --cwd apps/riders dev",
    "dev:web": "bun run --cwd apps/web dev",
    "build": "bun run --filter \"./apps/*\" build",
    "typecheck": "bun run --filter \"./apps/*\" typecheck",
    "lint": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md,yaml,yml}\"",
    "lint:fix": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md,yaml,yml}\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md,yaml,yml}\"",
    "db:migrate": "bun run --cwd apps/api migrate",
    "db:reset": "bun run --cwd apps/api migrate --reset",
    "db:seed": "bun run --cwd apps/api seed",
    "db:seed:demo": "bun run --cwd apps/api seed:demo",
    "db:bootstrap-admin": "bun run --cwd apps/api bootstrap-admin",
    "clean": "bun run --filter \"./apps/*\" clean"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
